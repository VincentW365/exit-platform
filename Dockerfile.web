# Production web image (Directive 4 section U).
# Multi-stage build; final image runs as a NON-ROOT user, carries no secrets,
# no source DMAIC, no test artifacts, no development database and no uploads
# (.dockerignore enforces the exclusions).
#
# Build:   docker build -f Dockerfile.web -t exit-platform-web .
# Run:     configuration comes exclusively from the environment; startup FAILS
#          CLOSED when any development-only provider or incomplete production
#          provider configuration is present (@exit/config guards).

FROM node:24-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @exit/db exec prisma generate \
 && pnpm --filter web build

FROM node:24-slim AS runner
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
# Non-root runtime user (U.3).
RUN groupadd --system app && useradd --system --gid app --home /app app
COPY --from=builder --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=builder --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=app:app /app/apps/web/public ./apps/web/public
USER app
EXPOSE 3000
# Liveness: /api/health; readiness: /api/ready (database + providers).
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
