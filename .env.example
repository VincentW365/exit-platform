# Employee Offboarding Platform - environment template (Stage 1)
# Copy to .env and fill in values. Never commit .env (gitignored).
# All data in non-production environments must be synthetic (BR-GOV-004).

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Local development PostgreSQL. Never point non-production at production data
# (REQ-SEC-037, REQ-INT-018).
DATABASE_URL=postgresql://exitplatform:CHANGE_ME@localhost:5432/exitplatform_dev

# Integration tests use a SEPARATE throwaway database (dropped/recreated freely).
DATABASE_URL_TEST=postgresql://exitplatform:CHANGE_ME@localhost:5432/exitplatform_test

# --- Session -----------------------------------------------------------------
# >= 32 characters of randomness. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Idle timeout (minutes) and absolute session lifetime (hours). REQ-SEC-004.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Development login (DEC-021 / IC-S1-005 / REQ-SEC-003) -------------------
# The development role switcher requires BOTH:
#   NODE_ENV != production   AND   ALLOW_DEV_LOGIN=true
# The application refuses to start if this is enabled in production.
ALLOW_DEV_LOGIN=true

# --- Files / attachments (REQ-SEC-019..022) ----------------------------------
# Local storage adapter directory (gitignored). Objects get random keys.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# disabled        -> uploads stay quarantined (PENDING) and cannot be downloaded
# dev-passthrough -> non-production only: marks uploads CLEAN with an explicit
#                    "no real malware scan performed" note. Refused in production.
SCAN_MODE=dev-passthrough

# --- Time (DEC-027 / IC-S1-007) ----------------------------------------------
APP_TIMEZONE=America/Jamaica

# --- Notifications (REQ-NOTIFY-013) ------------------------------------------
# Stage 1 permits only the sink adapter. Any other value fails validation.
EMAIL_MODE=sink

# --- Web ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
