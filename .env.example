# Employee Offboarding Platform - environment template (Stage 1)
# Copy to .env and fill in values. Never commit .env (gitignored).
# All data in non-production environments must be synthetic (BR-GOV-004).

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Local development PostgreSQL: an isolated, loopback-only (127.0.0.1:5433),
# SCRAM-authenticated cluster with separated roles - see DEVELOPMENT.md for
# the exact setup commands. Never point non-production at production data
# (REQ-SEC-037, REQ-INT-018). Passwords are local-only generated values.

# runtime role (web app + worker): least privilege, no DELETE/DDL anywhere
DATABASE_URL=postgresql://exit_app:CHANGE_ME_APP_PW@127.0.0.1:5433/exitplatform_dev
# migration role (prisma migrate / seed tooling): schema owner
DATABASE_URL_MIGRATE=postgresql://exit_migrate:CHANGE_ME_MIGRATE_PW@127.0.0.1:5433/exitplatform_dev
# integration-test harness: owner of the SEPARATE throwaway test database
DATABASE_URL_TEST=postgresql://exit_migrate:CHANGE_ME_MIGRATE_PW@127.0.0.1:5433/exitplatform_test
# runtime-privilege denial tests: app role against the test database
DATABASE_URL_TEST_RUNTIME=postgresql://exit_app:CHANGE_ME_APP_PW@127.0.0.1:5433/exitplatform_test

# --- Session -----------------------------------------------------------------
# >= 32 characters of randomness. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Idle timeout (minutes) and absolute session lifetime (hours). REQ-SEC-004.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Development login (DEC-021 / IC-S1-005 / REQ-SEC-003) -------------------
# The development role switcher requires BOTH:
#   APP_ENVIRONMENT != production   AND   ALLOW_DEV_LOGIN=true
# The application refuses to start if this is enabled in production.
ALLOW_DEV_LOGIN=true

# --- Files / attachments (REQ-SEC-019..022) ----------------------------------
# Local storage adapter directory (gitignored). Objects get random keys.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# disabled        -> uploads stay quarantined (PENDING) and cannot be downloaded
# dev-passthrough -> non-production only: marks uploads CLEAN with an explicit
#                    "no real malware scan performed" note. Refused in production.
SCAN_MODE=dev-passthrough

# --- Time (DEC-027 / IC-S1-007) ----------------------------------------------
APP_TIMEZONE=America/Jamaica

# --- Notifications (REQ-NOTIFY-013) ------------------------------------------
# Stage 1 permits only the sink adapter. Any other value fails validation.
EMAIL_MODE=sink

# Deployment environment for ROUTING (email routing directive). Distinct from
# NODE_ENV, which governs how the app is built and run.
#   development - local work; recipients must be non-deliverable.
#   test        - UAT against real configuration. The REAL To/Cc/Bcc are
#                 calculated exactly as in production, then every message is
#                 redirected to TEST_EMAIL and marked, so no real mailbox can
#                 be reached. Redirection cannot be switched off here.
#   uat         - a hosted testing deployment on ANY host (container, cloud
#                 provider, temporary web host, laptop). Non-production
#                 providers are permitted; so are production-CAPABLE ones
#                 pointed at separate UAT resources. Never production
#                 resources. Requires UAT_HOSTED_ACK=true.
#   production  - real recipients, real delivery.
# Defaults from NODE_ENV, so nothing has to be set to keep working: with this
# unset, a NODE_ENV=production process is a production deployment.
APP_ENVIRONMENT=development

# Explicit acknowledgement that this is a deliberately-chosen hosted testing
# deployment (DEC-062). Required for APP_ENVIRONMENT=uat, and for ANY
# non-production environment running on a production Node build. A hosted test
# environment is never inferred - it must be asked for twice, so that one
# stray or mistyped variable cannot turn production into UAT.
UAT_HOSTED_ACK=false

# The single mailbox every message is redirected to while testing. REQUIRED
# when APP_ENVIRONMENT=test - the application refuses to start without it,
# because a test deployment with nowhere to redirect would deliver for real.
TEST_EMAIL=

# --- Web ---------------------------------------------------------------------
# Where the web server LISTENS (LAN access for internal UAT, 2026-09-02).
#   0.0.0.0    accept connections from other workstations on the same network
#   127.0.0.1  this machine only
# The database is unaffected: it is loopback-only by its own configuration and
# other workstations reach data only through this application. Exposing the
# development role switcher (ALLOW_DEV_LOGIN) to a network means anyone who
# can open the address can sign in as any role - scope the Windows Firewall
# rule to the tester's address. See docs/operations/LanAccessForInternalUAT.md.
WEB_HOST=0.0.0.0
WEB_PORT=3000

# The DEVELOPMENT server only serves its own scripts to browser origins it
# knows, so a page opened from another workstation would render but never
# come alive. This machine's own network addresses are allowed automatically
# at each start (a changed DHCP lease needs no edit). Add a hostname here only
# if testers reach the host by a NAME rather than its address. Comma-separated;
# ignored in production, which has no such guard.
DEV_ALLOWED_ORIGINS=

# The address the platform puts in EMAIL LINKS (checklist, acknowledgement).
# "localhost" opened on another workstation is THAT workstation, so for LAN
# testing set this to the host's LAN address as printed by `pnpm dev`, e.g.
# http://192.168.1.20:3000 - and restart the web app and the worker.
APP_BASE_URL=http://localhost:3000

# --- BambooHR read-only directory (Directive 5.1) ----------------------------
# LOCAL USE ONLY. Put real values in the gitignored .env.local, NEVER here and
# NEVER in .env files that could be committed. Production refuses this raw-key
# form entirely (reference-based secrets are required there). The application
# reports only configured / not configured / invalid configuration - never the
# value. The adapter is strictly read-only (GET); no write call exists.
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=

# --- Branding (Directive 5.1) ------------------------------------------------
# Controlled logo asset path; replace the file (or point elsewhere) to rebrand
# without touching document templates. Missing/unreadable file -> documents
# fall back to the company name and still render.
BRAND_LOGO_PATH=apps/web/public/brand/berts-auto-parts.png
