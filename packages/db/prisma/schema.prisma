// Employee Offboarding Platform - Stage 1 schema.
// Translates docs/architecture/DataModel.md for the Stage 1 scope only.
// Synthetic data only in non-production (BR-GOV-004).
//
// Raw-SQL guarantees added in the migration (not expressible here):
//  - CHECK: cohort/purpose pairing on offboarding_case (REQ-CASE-013);
//  - triggers: audit_event append-only (REQ-SEC-024);
//  - trigger: offboarding_case DELETE forbidden (REQ-CASE-015).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// Prisma 7: connection URLs live in prisma.config.ts (Migrate) and the
// driver adapter passed to PrismaClient (runtime), never in this file.
datasource db {
  provider = "postgresql"
}

// --- Enums -------------------------------------------------------------------

enum Role {
  HR_MANAGER
  HR_OFFICER
  IT_RESPONDER
  FINANCE_RESPONDER
  LINE_MANAGER
  AUDITOR
  PRIVACY_OFFICER
  SYSTEM_ADMIN
}

enum DepartureType {
  RESIGNATION_WITH_NOTICE
  IMMEDIATE_RESIGNATION
  TERMINATION
}

enum CaseStatus {
  DRAFT
  PENDING_HR_REVIEW
  APPROVED
  ACTIVE
  CLEARANCE_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
  VOIDED
  REOPENED
}

enum CaseClassification {
  CONFIDENTIAL
  RESTRICTED
}

enum MeasurementCohort {
  BASELINE
  PILOT
  POST_ROLLOUT
}

enum RecordPurpose {
  OPERATIONAL
  TRAINING
  TEST
}

enum ReasonCaptureStatus {
  PENDING
  PROVIDED
  NOT_PROVIDED
  NOT_APPLICABLE
}

enum RehireEligibility {
  ELIGIBLE
  NOT_ELIGIBLE
  CONDITIONAL
}

enum ParticipantRole {
  OWNER
  HR_SUPPORT
  OVERSIGHT
  FINANCE
  MANAGER
}

enum ScanStatus {
  PENDING
  CLEAN
  REJECTED
  SCANNER_UNAVAILABLE
  // Stage 4 (Directive 4 section H) additions:
  QUARANTINED
  INFECTED
  SCAN_FAILED
}

enum AttachmentPurpose {
  RESIGNATION_LETTER
  SUPPORTING_DOCUMENT
  MANUAL_EXCEPTION_DOCUMENT
  ACKNOWLEDGEMENT_EVIDENCE
  ASSET_EVIDENCE
  TASK_EVIDENCE
  HANDOVER_EVIDENCE
}

enum ActorType {
  USER
  SYSTEM
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

enum BaselineEventType {
  DOCUMENT_REQUESTED
  DOCUMENT_APPROVED
  DOCUMENT_ISSUED
  NOTIFICATION_SENT
  ACCESS_REMOVAL_REQUESTED
  ACCESS_REMOVAL_DUE
  ACCESS_REMOVAL_COMPLETED
  ASSET_DUE
  ASSET_RETURNED
  ASSET_DISPOSITION_RECORDED
  EXIT_FEEDBACK_OFFERED
  EXIT_FEEDBACK_COMPLETED
  PROCESS_COMPLETED
}

enum MissingReason {
  NOT_RECORDED_CURRENT_PROCESS
  SOURCE_UNAVAILABLE
  NOT_APPLICABLE
  CASE_IN_PROGRESS
  DISPUTED
  UNKNOWN_OTHER
}

enum ConfigListKind {
  DEPARTMENT
  LOCATION
}

enum NoteVisibility {
  HR_ONLY
  HR_AND_OVERSIGHT
}

// --- Identity and authorization ---------------------------------------------

model User {
  id              String   @id @default(uuid()) @db.Uuid
  /// Stable identity-provider subject; dev identities use the "dev|" prefix.
  identitySubject String   @unique
  displayName     String
  workEmail       String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Stage 4 identity lifecycle (Directive 4 section E).
  department            String?
  managerUserId         String?             @db.Uuid
  lastSignInAt          DateTime?
  identitySource        String              @default("dev")
  provisioningStatus    ProvisioningStatus  @default(ACTIVE)
  deactivatedAt         DateTime?
  /// Sessions issued before this instant are rejected (immediate revocation).
  sessionsInvalidatedAt DateTime?

  roleAssignments    RoleAssignment[] @relation("assignee")
  ownedCases         OffboardingCase[] @relation("caseOwner")
  createdCases       OffboardingCase[] @relation("caseCreator")
  officerCases       OffboardingCase[] @relation("caseOfficer")
  managedCases       OffboardingCase[] @relation("caseManager")
  participations     CaseParticipant[] @relation("participantUser")

  @@map("app_user")
}

model RoleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation("assignee", fields: [userId], references: [id])
  role         Role
  reason       String
  grantedById  String?   @db.Uuid
  grantedAt    DateTime  @default(now())
  /// Stage 4 (E.6): optional review expiry; expired roles are revoked by sweep.
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?   @db.Uuid
  revokeReason String?

  @@index([userId, role])
  @@map("role_assignment")
}

// --- Employee source ---------------------------------------------------------

/// Local cache of adapter lookups; provenance for the snapshot. Never the
/// case truth after approval (Architecture.md domain rules).
model EmployeeSourceRecord {
  id           String   @id @default(uuid()) @db.Uuid
  sourceSystem String
  sourceId     String
  displayName  String
  workEmail    String?
  jobTitle     String?
  department   String?
  location     String?
  retrievedAt  DateTime
  payload      Json
  // Directive 6.1 (A/B): organization graph columns promoted from the payload
  // so hierarchy-driven routing and validation query real columns. Only the
  // approved minimum fields; the payload is retained for provenance.
  managerName     String?
  managerSourceId String?
  division        String?
  employeeNumber  String?
  active          Boolean   @default(true)
  lastSyncedAt    DateTime?

  @@unique([sourceSystem, sourceId])
  @@index([sourceSystem, managerSourceId])
  @@map("employee_source_record")
}

// --- Case --------------------------------------------------------------------

model OffboardingCase {
  id         String        @id @default(uuid()) @db.Uuid
  caseNumber String        @unique
  status     CaseStatus    @default(DRAFT)
  departureType DepartureType
  classification CaseClassification @default(CONFIDENTIAL)

  /// Two separate dimensions (REQ-CASE-013): cohort required iff OPERATIONAL.
  measurementCohort MeasurementCohort?
  recordPurpose     RecordPurpose      @default(OPERATIONAL)

  employeeSourceSystem String
  employeeSourceId     String
  employeeDisplayName  String
  employeeWorkEmail    String?
  department           String
  location             String
  jobTitle             String?

  receivedAt    DateTime
  receiptSource String
  proposedLastDay       DateTime?
  confirmedLastDay      DateTime?
  effectiveSeparationAt DateTime?

  noticeProvidedDays Int?
  noticeRequiredDays Int?
  /// Approved notice treatment wording; never an entitlement calculation.
  noticeTreatment    String?

  /// IC-S1-008: nullable until DEC-031 approves a taxonomy.
  reasonCategoryId    String?             @db.Uuid
  reasonCategory      ReasonCategory?     @relation(fields: [reasonCategoryId], references: [id])
  reasonCaptureStatus ReasonCaptureStatus @default(PENDING)
  /// RESTRICTED_HR free text (REQ-PRIV-024); masked outside HR participants.
  reasonNotes         String?

  /// RESTRICTED_HR (DEC-032): HR Manager only.
  rehireEligibility RehireEligibility?

  ownerId     String @db.Uuid
  owner       User   @relation("caseOwner", fields: [ownerId], references: [id])
  createdById String @db.Uuid
  createdBy   User   @relation("caseCreator", fields: [createdById], references: [id])

  /// Directive 6.1 (E): operational HR Officer ownership, assigned manually by
  /// the accountable HR Manager before workflow activation.
  assignedOfficerId String? @db.Uuid
  assignedOfficer   User?   @relation("caseOfficer", fields: [assignedOfficerId], references: [id])

  /// Directive 6.1 (F): manager routing derived from the synchronized
  /// directory, reviewed and confirmed by HR before activation. The name and
  /// source id are directory provenance; managerUserId is the resolved
  /// application account that receives manager-owned tasks.
  managerName            String?
  managerSourceId        String?
  managerUserId          String?            @db.Uuid
  managerUser            User?              @relation("caseManager", fields: [managerUserId], references: [id])
  managerSource          CaseManagerSource?
  managerConfirmedAt     DateTime?
  managerConfirmedById   String?            @db.Uuid
  /// Set once when a later directory sync disagrees with the confirmed
  /// manager; HR reviews and re-confirms (never silently reassigned).
  managerChangeFlaggedAt DateTime?

  /// Directive 6.1 (J): the six assignment-plan confirmations
  /// {key: {at, byId}} captured before activation.
  activationConfirmations Json?

  /// Directive 6.3 (V): benefits/provider applicability - YES/NO/UNKNOWN.
  /// UNKNOWN opens an HR exception; YES derives the provider notification;
  /// NO creates nothing. otherProvider is YES/NO only (app-enforced).
  groupHealthApplicability   BenefitsApplicability @default(UNKNOWN)
  groupLifeApplicability     BenefitsApplicability @default(UNKNOWN)
  otherProviderApplicability BenefitsApplicability @default(NO)
  benefitsConfirmedById      String?               @db.Uuid
  benefitsConfirmedAt        DateTime?
  /// 'DERIVED' when a future source system supplies it; 'HR_CONFIRMED' today.
  benefitsSource             String?

  /// Stage 4 (P): identity fields anonymized through the approved privacy
  /// workflow; audit and structural evidence are preserved.
  anonymizedAt   DateTime?
  anonymizedById String?   @db.Uuid

  /// Optimistic concurrency (Architecture.md section 8).
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?
  closeReason String?

  snapshot       EmployeeSnapshot?
  statusHistory  CaseStatusHistory[]
  participants   CaseParticipant[]
  notes          CaseNote[]
  attachments    Attachment[]
  baselineEvents BaselineEvent[]
  documents      DocumentInstance[]
  actionForms    ActionFormVersion[]
  surveyInvitations SurveyInvitation[]
  workflowInstances WorkflowInstance[]
  workflowTasks     WorkflowTask[]
  notifications     NotificationRecord[]
  assetRecoveryItems AssetRecoveryItem[]
  handover           HandoverRecord?
  exceptions         CaseException[]
  clearanceRecords   ClearanceRecord[]
  retentionHolds     RetentionHold[]
  requiredActions    CaseRequiredAction[]

  @@index([status])
  @@index([ownerId])
  @@index([assignedOfficerId])
  @@index([effectiveSeparationAt])
  @@index([measurementCohort, recordPurpose])
  @@index([employeeSourceId])
  @@index([departureType])
  @@map("offboarding_case")
}

/// Directive 6.1 (F): provenance of the case's manager routing.
enum CaseManagerSource {
  DIRECTORY
  OVERRIDE
  MANUAL
}

/// Immutable snapshot captured exactly once at approval (REQ-CASE-004).
model EmployeeSnapshot {
  id            String          @id @default(uuid()) @db.Uuid
  caseId        String          @unique @db.Uuid
  case          OffboardingCase @relation(fields: [caseId], references: [id])
  sourceSystem  String
  sourceId      String
  retrievedAt   DateTime
  capturedAt    DateTime        @default(now())
  capturedById  String          @db.Uuid
  payload       Json
  checksum      String
  schemaVersion Int

  @@map("employee_snapshot")
}

model CaseStatusHistory {
  id            String          @id @default(uuid()) @db.Uuid
  caseId        String          @db.Uuid
  case          OffboardingCase @relation(fields: [caseId], references: [id])
  fromStatus    CaseStatus?
  toStatus      CaseStatus
  actorId       String          @db.Uuid
  reason        String?
  correlationId String
  occurredAt    DateTime        @default(now())

  @@index([caseId, occurredAt])
  @@map("case_status_history")
}

model CaseParticipant {
  id              String          @id @default(uuid()) @db.Uuid
  caseId          String          @db.Uuid
  case            OffboardingCase @relation(fields: [caseId], references: [id])
  userId          String          @db.Uuid
  user            User            @relation("participantUser", fields: [userId], references: [id])
  participantRole ParticipantRole
  reason          String?
  addedById       String          @db.Uuid
  addedAt         DateTime        @default(now())
  removedAt       DateTime?
  removedById     String?         @db.Uuid
  removeReason    String?

  @@index([caseId])
  @@index([userId])
  @@map("case_participant")
}

/// Internal notes with immutable edit history (REQ-CASE-019): editing creates
/// a new note that supersedes the old one; rows are never updated in place.
model CaseNote {
  id           String          @id @default(uuid()) @db.Uuid
  caseId       String          @db.Uuid
  case         OffboardingCase @relation(fields: [caseId], references: [id])
  authorId     String          @db.Uuid
  visibility   NoteVisibility  @default(HR_ONLY)
  body         String
  createdAt    DateTime        @default(now())
  supersedesId String?         @unique @db.Uuid
  supersedes   CaseNote?       @relation("noteSupersession", fields: [supersedesId], references: [id])
  supersededBy CaseNote?       @relation("noteSupersession")

  @@index([caseId, createdAt])
  @@map("case_note")
}

// --- Files -------------------------------------------------------------------

model Attachment {
  id           String            @id @default(uuid()) @db.Uuid
  caseId       String            @db.Uuid
  case         OffboardingCase   @relation(fields: [caseId], references: [id])
  purpose      AttachmentPurpose
  /// Display name only; storage uses the random objectKey (REQ-SEC-021).
  fileName     String
  objectKey    String            @unique
  mimeType     String
  sizeBytes    Int
  checksum     String
  scanStatus   ScanStatus        @default(PENDING)
  scanNote     String?
  uploadedById String            @db.Uuid
  createdAt    DateTime          @default(now())

  @@index([caseId])
  @@map("attachment")
}

// --- Audit -------------------------------------------------------------------

/// Append-only (enforced by trigger in the migration; REQ-SEC-024).
model AuditEvent {
  id             String      @id @default(uuid()) @db.Uuid
  eventType      String
  occurredAt     DateTime    @default(now())
  actorType      ActorType
  actorId        String?     @db.Uuid
  effectiveRoles String[]
  objectType     String
  objectId       String
  caseId         String?     @db.Uuid
  result         AuditResult
  correlationId  String
  metadata       Json
  appVersion     String

  @@index([caseId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_event")
}

// --- Baseline capture --------------------------------------------------------

/// Append-only baseline facts (BaselineDataCapturePlan.md section 5).
model BaselineEvent {
  id              String            @id @default(uuid()) @db.Uuid
  caseId          String            @db.Uuid
  case            OffboardingCase   @relation(fields: [caseId], references: [id])
  eventType       BaselineEventType
  occurredAt      DateTime?
  missingReason   MissingReason?
  missingNote     String?
  detail          String?
  evidenceRef     String?
  recordedById    String            @db.Uuid
  recordedAt      DateTime          @default(now())
  supersededAt    DateTime?
  supersededById  String?           @db.Uuid
  supersedeReason String?

  @@index([caseId, eventType])
  @@map("baseline_event")
}

// --- Configuration -----------------------------------------------------------

model HolidayCalendar {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  timezone  String    @default("America/Jamaica")
  version   Int
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  holidays  Holiday[]

  // Stage 4 (Directive 4 section K): approval + effective period. Existing
  // tasks keep their calculation provenance; a new version never rewrites
  // historical due dates.
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  note          String?

  @@unique([name, version])
  @@map("holiday_calendar")
}

model Holiday {
  id         String          @id @default(uuid()) @db.Uuid
  calendarId String          @db.Uuid
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id])
  /// ISO date in calendar timezone.
  date       String
  label      String

  @@unique([calendarId, date])
  @@map("holiday")
}

/// Versioned reference data capable of holding the HR-approved taxonomy later
/// (IC-S1-008). Stage 1 seeds clearly-labelled TEST-ONLY records only.
/// Stage 4 (Directive 4 section J): full configurable taxonomy - never an
/// enum; historical cases keep the category row selected at the time.
model ReasonCategory {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  label           String
  taxonomyVersion Int
  isActive        Boolean  @default(false)
  isTestOnly      Boolean  @default(true)
  createdAt       DateTime @default(now())

  description     String?
  /// null = applicable to both voluntary and involuntary departures.
  voluntary       Boolean?
  departureTypes  DepartureType[]
  reportingGroup  String?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  sortOrder       Int      @default(0)
  sensitive       Boolean  @default(false)
  createdById     String?  @db.Uuid
  approvedById    String?  @db.Uuid
  approvedAt      DateTime?
  retiredAt       DateTime?
  changeReason    String?

  cases           OffboardingCase[]

  @@map("reason_category")
}

/// All improvement automation defaults to disabled (IC-S1-004).
model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("feature_flag")
}

model ConfigListItem {
  id          String         @id @default(uuid()) @db.Uuid
  kind        ConfigListKind
  value       String
  isActive    Boolean        @default(true)
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())

  @@unique([kind, value])
  @@map("config_list_item")
}

// --- Stage 2: controlled documents, action form, exit survey -----------------

enum DocumentType {
  RESIGNATION_ACCEPTANCE_WITH_NOTICE
  IMMEDIATE_RESIGNATION_ACKNOWLEDGEMENT
  OFFBOARDING_ACTION_FORM
  MANUAL_EXCEPTION_DOCUMENT
  TERMINATION_DOCUMENT_PLACEHOLDER
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum DocumentStatus {
  DRAFT
  VALIDATION_FAILED
  PENDING_APPROVAL
  RETURNED
  APPROVED
  RENDERING
  RENDERED
  MANUALLY_ISSUED
  SUPERSEDED
  VOIDED
  RENDER_FAILED
}

enum IssueMethod {
  HAND_DELIVERY
  REGISTERED_MAIL
  OTHER_APPROVED
}

enum RecipientClass {
  EMPLOYEE
  AUTHORIZED_REPRESENTATIVE
  INTERNAL_RECORD
}

enum AttestationSubject {
  DOCUMENT
  ACTION_FORM
  HANDOVER
}

enum AttestationKind {
  HR_DOCUMENT_APPROVAL
  MANAGER_FORM_APPROVAL
  HR_FORM_FINAL_APPROVAL
  MANAGER_HANDOVER_ATTESTATION
  /// Directive 6.3 F: the assigned HR Officer completes the form (attested).
  HR_FORM_COMPLETION
}

enum ActionFormStatus {
  DRAFT
  RETURNED
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  SUPERSEDED
  VOIDED
  /// Directive 6.3 F: HR-validated lifecycle (no manager approval). The four
  /// legacy states above stay for historical rows only.
  READY_FOR_HR_REVIEW
  HR_REVIEWED
  COMPLETE
  RETURNED_FOR_CORRECTION
}

enum AcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  NOT_OBTAINED
  NOT_APPLICABLE
}

enum SurveyQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  RATING_1_5
  YES_NO_PNTS
  SHORT_TEXT
  LONG_TEXT
}

enum InvitationStatus {
  PENDING
  MANUALLY_SENT
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
  INVALID_CONTACT
  NOT_ELIGIBLE
}

enum ResponseChannel {
  ONLINE_SURVEY
  VERBAL_DEBRIEF
  DECLINED
  NOT_COMPLETED
}

/// Immutable-once-active controlled document templates (Directive 2 section B).
model DocumentTemplate {
  id                  String         @id @default(uuid()) @db.Uuid
  documentType        DocumentType
  name                String
  version             Int
  status              TemplateStatus @default(DRAFT)
  /// Plain-text structured content with [[PLACEHOLDER]] tokens.
  contentBody         String
  allowedPlaceholders String[]
  contentChecksum     String
  changeReason        String?
  createdById         String         @db.Uuid
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  activatedById       String?        @db.Uuid
  activatedAt         DateTime?
  supersededAt        DateTime?
  retiredAt           DateTime?
  documents           DocumentInstance[]

  @@unique([documentType, version])
  @@index([documentType, status])
  @@map("document_template")
}

/// Case document instances (Directive 2 section D lifecycle).
model DocumentInstance {
  id               String         @id @default(uuid()) @db.Uuid
  caseId           String         @db.Uuid
  case             OffboardingCase @relation(fields: [caseId], references: [id])
  documentType     DocumentType
  templateId       String?        @db.Uuid
  template         DocumentTemplate? @relation(fields: [templateId], references: [id])
  templateVersion  Int?
  version          Int
  status           DocumentStatus @default(DRAFT)
  /// Exact field values captured for THIS version (never silently refreshed).
  fieldSnapshot    Json
  /// Rendered body text (placeholders substituted) captured at submission.
  contentSnapshot  String?
  contentChecksum  String?
  validationErrors Json?
  outdatedReason   String?
  returnReason     String?
  voidReason       String?
  /// Manual-exception documents reference an uploaded controlled attachment.
  exceptionAttachmentId String?   @db.Uuid
  exceptionReason  String?
  pdfObjectKey     String?        @unique
  pdfChecksum      String?
  renderAttempts   Int            @default(0)
  renderError      String?
  issuedById       String?        @db.Uuid
  issuedAt         DateTime?
  issueMethod      IssueMethod?
  recipientClass   RecipientClass?
  issueNote        String?
  createdById      String         @db.Uuid
  /// Who validated and submitted this version for approval (maker-checker:
  /// the submitter can never be the approver). Null only on legacy rows.
  submittedById    String?        @db.Uuid
  submittedAt      DateTime?
  approvedAt       DateTime?
  renderedAt       DateTime?
  rowVersion       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([caseId, documentType, version])
  @@index([caseId, documentType])
  @@index([status])
  @@map("document_instance")
}

/// Authenticated approval/attestation records (DEC-025 Option B).
/// Core columns are immutable (trigger); only invalidation fields may change.
model Attestation {
  id                 String             @id @default(uuid()) @db.Uuid
  subjectType        AttestationSubject
  subjectId          String             @db.Uuid
  subjectVersion     Int
  kind               AttestationKind
  caseId             String             @db.Uuid
  actorId            String             @db.Uuid
  actorDisplayName   String
  actorRole          String
  meaning            String
  contentChecksum    String
  correlationId      String
  createdAt          DateTime           @default(now())
  invalidatedAt      DateTime?
  invalidatedReason  String?

  @@index([subjectType, subjectId])
  @@index([caseId])
  @@map("attestation")
}

/// One versioned offboarding action form per case (Directive 2 section F).
model ActionFormVersion {
  id                    String                @id @default(uuid()) @db.Uuid
  caseId                String                @db.Uuid
  case                  OffboardingCase       @relation(fields: [caseId], references: [id])
  version               Int
  status                ActionFormStatus      @default(DRAFT)
  /// Frozen employee/case identification for this version.
  fieldSnapshot         Json
  priorStatus           String                @default("EMPLOYED")
  newStatus             String                @default("SEPARATED")
  hrChecklist           Json
  financeChecklist      Json
  financeNotes          String?
  ackStatus             AcknowledgementStatus @default(PENDING)
  ackDate               DateTime?
  ackMethod             String?
  ackReason             String?
  ackEvidenceAttachmentId String?             @db.Uuid
  hrRemarks             String?
  returnReason          String?
  voidReason            String?
  outdatedReason        String?
  pdfObjectKey          String?               @unique
  pdfChecksum           String?
  renderError           String?
  createdById           String                @db.Uuid
  /// Directive 6.3 F: HR-validated lifecycle actor evidence (house pattern).
  submittedById         String?               @db.Uuid
  submittedAt           DateTime?
  hrReviewedById        String?               @db.Uuid
  hrReviewedAt          DateTime?
  completedById         String?               @db.Uuid
  completedAt           DateTime?
  rowVersion            Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([caseId, version])
  @@index([status])
  @@map("action_form_version")
}

/// Versioned exit-survey templates (Directive 2 section G).
model SurveyTemplate {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int
  status        TemplateStatus   @default(DRAFT)
  title         String
  introText     String
  privacyNotice String
  createdById   String?          @db.Uuid
  activatedById String?          @db.Uuid
  activatedAt   DateTime?
  createdAt     DateTime         @default(now())
  questions     SurveyQuestion[]
  invitations   SurveyInvitation[]

  @@unique([code, version])
  @@map("survey_template")
}

model SurveyQuestion {
  id         String             @id @default(uuid()) @db.Uuid
  templateId String             @db.Uuid
  template   SurveyTemplate     @relation(fields: [templateId], references: [id])
  order      Int
  type       SurveyQuestionType
  prompt     String
  required   Boolean            @default(false)
  options    String[]
  maxLength  Int?
  answers    SurveyAnswer[]

  @@unique([templateId, order])
  @@map("survey_question")
}

/// Survey invitations: token HASH only, never the raw token (section H).
model SurveyInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  caseId           String           @db.Uuid
  case             OffboardingCase  @relation(fields: [caseId], references: [id])
  templateId       String           @db.Uuid
  template         SurveyTemplate   @relation(fields: [templateId], references: [id])
  status           InvitationStatus @default(PENDING)
  eligibilityNote  String?
  overrideReason   String?
  tokenHash        String?          @unique
  tokenGeneratedAt DateTime?
  invitationDueAt  DateTime
  manualSentById   String?          @db.Uuid
  manualSentAt     DateTime?
  reminder1DueAt   DateTime?
  reminder1SentAt  DateTime?
  reminder2DueAt   DateTime?
  reminder2SentAt  DateTime?
  expiresAt        DateTime?
  responseChannel  ResponseChannel?
  completedAt      DateTime?
  invalidContactNote String?
  cancelReason     String?
  createdById      String           @db.Uuid
  rowVersion       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  response         SurveyResponse?

  @@index([caseId])
  @@index([status])
  @@map("survey_invitation")
}

/// One final response per invitation; append-only (section H rules 7-10).
model SurveyResponse {
  id           String           @id @default(uuid()) @db.Uuid
  invitationId String           @unique @db.Uuid
  invitation   SurveyInvitation @relation(fields: [invitationId], references: [id])
  caseId       String           @db.Uuid
  channel      ResponseChannel
  submittedAt  DateTime         @default(now())
  /// Set for VERBAL_DEBRIEF: the HR user who recorded it.
  recordedById String?          @db.Uuid
  answers      SurveyAnswer[]

  @@index([caseId])
  @@map("survey_response")
}

model SurveyAnswer {
  id          String         @id @default(uuid()) @db.Uuid
  responseId  String         @db.Uuid
  response    SurveyResponse @relation(fields: [responseId], references: [id])
  questionId  String         @db.Uuid
  question    SurveyQuestion @relation(fields: [questionId], references: [id])
  valueChoice String[]
  valueRating Int?
  /// RESTRICTED_HR free text.
  valueText   String?

  @@unique([responseId, questionId])
  @@map("survey_answer")
}

/// PDF render jobs claimed by the worker for retry handling (section J).
model RenderJob {
  id            String             @id @default(uuid()) @db.Uuid
  subjectType   AttestationSubject
  subjectId     String             @db.Uuid
  status        String             @default("QUEUED")
  attempts      Int                @default(0)
  lastError     String?
  correlationId String
  claimedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@map("render_job")
}

/// Human-readable case-number allocation (REQ-CASE-001): OFF-<year>-<seq>,
/// allocated transactionally per year.
model CaseNumberCounter {
  year Int @id
  next Int @default(1)

  @@map("case_number_counter")
}

/// Integration placeholders: adapters exist, nothing is configured, and no
/// credential is ever stored here (REQ-INT-018, IC-S1-006).
model IntegrationPlaceholder {
  key         String  @id
  displayName String
  mode        String  @default("stub")
  configured  Boolean @default(false)
  notes       String?

  @@map("integration_placeholder")
}

// --- Stage 3: workflows, tasks, notifications, assets, handover, clearance ---

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum WorkflowInstanceStatus {
  PREVIEW
  ACTIVE
  ON_HOLD
  CLEARANCE_PENDING
  COMPLETED
  CANCELLED
  SUPERSEDED
}

enum TaskStatus {
  NOT_READY
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
  WAIVED
  CANCELLED
}

enum TaskDepartment {
  HR
  IT
  FINANCE
  LINE_MANAGER
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskKind {
  STANDARD
  ACCESS_REVOCATION
}

/// What instant a task's due date is calculated from (section E).
enum DueBasis {
  CASE_RECEIVED
  WORKFLOW_ACTIVATION
  EFFECTIVE_SEPARATION
  FINAL_WORKING_DAY
  NONE
}

enum DueOffsetKind {
  BUSINESS_DAYS
  CALENDAR_DAYS
  /// The due instant IS the source instant (exact-time security tasks).
  EXACT_TIME
}

enum ReleaseBasis {
  IMMEDIATE
  /// Released relative to the effective separation instant (restricted timing).
  EFFECTIVE_SEPARATION
}

enum TaskEvidenceKind {
  NONE
  NOTE
  ATTACHMENT
  LINKED_RECORD
}

enum NotificationType {
  IT_ACCESS_REMOVAL
  FINANCE_OFFBOARDING
  LINE_MANAGER_HANDOVER
  SAGICOR_GROUP_HEALTH_REMOVAL
  NCB_GROUP_LIFE_REMOVAL
  SURVEY_INVITATION_REFERENCE
  MANUAL_EXCEPTION_NOTIFICATION
  /// Directive 6.3 K/N: configurable external purposes beyond Sagicor/NCB.
  PAYROLL_OR_BANK_NOTIFICATION
  OTHER_EXTERNAL_OFFBOARDING_NOTIFICATION
}

enum NotificationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  READY_FOR_MANUAL_SEND
  MANUALLY_SENT
  CANCELLED
  FAILED
  SUPERSEDED
  /// Directive 6.3 K/T/U: automated delivery + no-login evidence chain.
  SENT
  ACKNOWLEDGED
  CONFIRMED_COMPLETE
}

enum NotificationRecipient {
  INTERNAL_DEPARTMENT
  EXTERNAL_PROVIDER
  EMPLOYEE
}

enum AssetType {
  EMPLOYEE_ID_CARD
  ACCESS_CARD
  HEALTH_CARD
  LUNCH_CARD
  UNIFORM
  LAPTOP
  MOBILE_PHONE
  KEYS
  EMPLOYEE_HANDBOOK
  COMPANY_DOCUMENTS
  OTHER
}

/// Operational states + final dispositions (section L). OVERDUE is computed
/// from expectedReturnAt, never stored, so it cannot go stale.
enum AssetRecoveryStatus {
  EXPECTED
  REQUESTED
  PARTIALLY_RETURNED
  RETURNED
  NOT_ISSUED
  LOST
  DAMAGED
  WAIVED
  WRITTEN_OFF
  UNRESOLVED
}

enum HandoverStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_APPLICABLE
  WAIVED
}

enum ExceptionType {
  TASK_OVERDUE
  CRITICAL_ACCESS_OVERDUE
  TASK_BLOCKED
  RENDER_FAILED
  DOCUMENT_UNAPPROVED
  NOTIFICATION_OVERDUE
  NOTIFICATION_FAILED
  ASSET_OVERDUE
  ASSET_UNRESOLVED
  HANDOVER_OVERDUE
  MISSING_APPROVAL
  INVALID_CASE_DATE
  WORKFLOW_ACTIVATION_FAILURE
  DUE_DATE_RETROSPECTIVE_CHANGE
  CLEARANCE_BLOCKED
  /// Directive 6.3: exception-first automation (O/R/T/U/V).
  RECIPIENT_MISSING
  BENEFITS_APPLICABILITY_UNKNOWN
  ACKNOWLEDGEMENT_OVERDUE
  AUTO_SEND_BLOCKED
}

enum ExceptionSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

/// Versioned workflow definitions (section B). ACTIVE versions are immutable
/// (trigger); editing an active definition means drafting a new version.
model WorkflowDefinition {
  id                   String                   @id @default(uuid()) @db.Uuid
  workflowType         DepartureType
  name                 String
  version              Int
  status               WorkflowDefinitionStatus @default(DRAFT)
  description          String
  activationConditions String
  effectiveDate        DateTime?
  changeReason         String?
  configChecksum       String
  createdById          String                   @db.Uuid
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  activatedById        String?                  @db.Uuid
  activatedAt          DateTime?
  supersededAt         DateTime?
  retiredAt            DateTime?

  taskDefs  WorkflowTaskDefinition[]
  instances WorkflowInstance[]

  @@unique([workflowType, version])
  @@index([workflowType, status])
  @@map("workflow_definition")
}

/// Task rows of one workflow-definition version (section D). Frozen once the
/// definition leaves DRAFT (trigger). "Removing" a task in a draft disables
/// it (enabled=false) - rows are never hard-deleted.
model WorkflowTaskDefinition {
  id           String             @id @default(uuid()) @db.Uuid
  definitionId String             @db.Uuid
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id])
  taskCode     String
  sortOrder    Int
  enabled      Boolean            @default(true)
  title        String
  /// Safe operational description - no restricted HR content.
  description  String
  department   TaskDepartment
  requiredRole Role
  taskKind     TaskKind           @default(STANDARD)
  priority     TaskPriority       @default(NORMAL)
  /// Restricted/minimum-data handling indicator for queue rows.
  confidential Boolean            @default(false)

  required        Boolean @default(true)
  waiverAllowed   Boolean @default(false)
  waiverAuthority Role    @default(HR_MANAGER)

  dueBasis           DueBasis
  dueOffsetDays      Int           @default(0)
  dueOffsetKind      DueOffsetKind @default(BUSINESS_DAYS)
  releaseBasis       ReleaseBasis  @default(IMMEDIATE)
  releaseOffsetHours Int           @default(0)
  /// E.3/E.4: whether case ON_HOLD pauses this task's due date.
  pausesOnHold       Boolean       @default(true)
  /// D.7: whether BLOCKED pauses the SLA (explicit per definition).
  blockPausesSla     Boolean       @default(false)

  dependsOnCodes String[]
  evidenceKind   TaskEvidenceKind @default(NOTE)
  evidenceNote   String?
  slaNote        String?
  escalationNote String?

  tasks WorkflowTask[]

  @@unique([definitionId, taskCode])
  @@map("workflow_task_definition")
}

/// One live workflow instance per active case (section C); the case is pinned
/// to the exact definition version and checksum at activation.
model WorkflowInstance {
  id                String                 @id @default(uuid()) @db.Uuid
  caseId            String                 @db.Uuid
  case              OffboardingCase        @relation(fields: [caseId], references: [id])
  definitionId      String                 @db.Uuid
  definition        WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  definitionVersion Int
  workflowType      DepartureType
  configChecksum    String
  status            WorkflowInstanceStatus @default(ACTIVE)
  activatedById     String                 @db.Uuid
  activatedAt       DateTime               @default(now())
  correlationId     String

  requiredTaskCount  Int       @default(0)
  completedTaskCount Int       @default(0)
  waivedTaskCount    Int       @default(0)
  blockedTaskCount   Int       @default(0)
  overdueTaskCount   Int       @default(0)
  completionPct      Int       @default(0)
  clearanceReady     Boolean   @default(false)
  readinessDetail    Json?
  readinessCheckedAt DateTime?

  holdStartedAt    DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  supersededAt     DateTime?
  supersededReason String?
  rowVersion       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tasks WorkflowTask[]

  @@index([caseId])
  @@index([status])
  @@map("workflow_instance")
}

/// Task instances (section D) including the exact-time access-revocation
/// fields (section I). caseId is denormalized for queue queries.
model WorkflowTask {
  id           String                  @id @default(uuid()) @db.Uuid
  instanceId   String                  @db.Uuid
  instance     WorkflowInstance        @relation(fields: [instanceId], references: [id])
  caseId       String                  @db.Uuid
  case         OffboardingCase         @relation(fields: [caseId], references: [id])
  taskDefId    String?                 @db.Uuid
  taskDef      WorkflowTaskDefinition? @relation(fields: [taskDefId], references: [id])
  taskCode     String
  sortOrder    Int
  title        String
  description  String
  department   TaskDepartment
  requiredRole Role
  taskKind     TaskKind                @default(STANDARD)
  priority     TaskPriority
  confidential Boolean

  required        Boolean
  waiverAllowed   Boolean
  waiverAuthority Role
  status          TaskStatus @default(NOT_READY)
  assigneeId      String?    @db.Uuid
  dependsOnCodes  String[]
  pausesOnHold    Boolean
  blockPausesSla  Boolean

  releaseAt          DateTime?
  releasedAt         DateTime?
  dueAt              DateTime?
  originalDueAt      DateTime?
  /// Calculation provenance (E): rule text + source instant + calendar version.
  dueRule            String?
  dueSourceAt        DateTime?
  dueCalendarVersion Int?
  dueCalculatedAt    DateTime?
  dueRecalcReason    String?

  startedAt     DateTime?
  startedById   String?   @db.Uuid
  blockedAt     DateTime?
  blockedReason String?
  blockerOwner  String?
  waivedAt      DateTime?
  waivedById    String?   @db.Uuid
  waiverReason  String?
  completedAt   DateTime?
  completedById String?   @db.Uuid
  completionNote String?
  /// I.5: exact stored delay when completed after the due instant.
  lateMinutes   Int?
  evidenceKind  TaskEvidenceKind @default(NOTE)
  evidenceAttachmentId String?   @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  escalationLevel Int       @default(0)
  escalatedAt     DateTime?

  // Access-revocation control fields (section I); null for standard tasks.
  accessSystems           String[]
  accessSystemsCompleted  String[]
  accessSystemsUnresolved String[]
  accessResult            String?
  earlyCompletionReason   String?
  incidentRef             String?

  rowVersion Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  corrections TaskCorrection[]

  @@unique([instanceId, taskCode])
  @@index([caseId])
  @@index([department, status])
  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@map("workflow_task")
}

/// D.12/D.13: authorized corrections to completed tasks - append-only.
model TaskCorrection {
  id              String       @id @default(uuid()) @db.Uuid
  taskId          String       @db.Uuid
  task            WorkflowTask @relation(fields: [taskId], references: [id])
  field           String
  originalValue   String?
  correctedValue  String?
  reason          String
  clearanceEffect String?
  actorId         String       @db.Uuid
  createdAt       DateTime     @default(now())

  @@index([taskId])
  @@map("task_correction")
}

/// Deterministic notification templates (section K).
model NotificationTemplate {
  id                  String                @id @default(uuid()) @db.Uuid
  notificationType    NotificationType
  version             Int
  status              TemplateStatus        @default(DRAFT)
  recipientClass      NotificationRecipient
  name                String
  subjectTemplate     String
  bodyTemplate        String
  allowedPlaceholders String[]
  /// K: declaration of the minimum data this notification may carry.
  minimumDataNote     String
  contentChecksum     String
  changeReason        String?
  createdById         String                @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  activatedById       String?               @db.Uuid
  activatedAt         DateTime?
  supersededAt        DateTime?

  records NotificationRecord[]

  @@unique([notificationType, version])
  @@map("notification_template")
}

/// Controlled per-case notification records (section K). Never live email.
model NotificationRecord {
  id               String                @id @default(uuid()) @db.Uuid
  caseId           String                @db.Uuid
  case             OffboardingCase       @relation(fields: [caseId], references: [id])
  notificationType NotificationType
  templateId       String                @db.Uuid
  template         NotificationTemplate  @relation(fields: [templateId], references: [id])
  templateVersion  Int
  recipientClass   NotificationRecipient
  status           NotificationStatus    @default(DRAFT)
  /// K.11: case + type + recipient class + workflow version + effective event.
  idempotencyKey   String                @unique

  subjectSnapshot String?
  bodySnapshot    String?
  contentChecksum String?
  fieldSnapshot   Json

  applicabilityNote        String?
  applicabilityConfirmedById String?  @db.Uuid
  applicabilityConfirmedAt DateTime?

  approvedById          String?   @db.Uuid
  approvedAt            DateTime?
  approvalInvalidatedAt DateTime?
  invalidationReason    String?

  readyAt        DateTime?
  manualSentById String?   @db.Uuid
  manualSentAt   DateTime?
  sentMethod     String?
  /// Approved destination REFERENCE (never a personal address in logs).
  destinationRef String?
  sentNote       String?
  cancelReason   String?
  failReason     String?
  supersededReason String?

  /// Directive 6.3 K/R: email-action fields. origin distinguishes
  /// rules-engine-created records; controlLevel snapshots the applied send
  /// control so later configuration changes never rewrite history.
  origin           NotificationOrigin @default(MANUAL)
  derivedActionId  String?            @db.Uuid
  derivedAction    CaseRequiredAction? @relation(fields: [derivedActionId], references: [id])
  controlLevel     String?
  scheduledSendAt  DateTime?
  sentAt           DateTime?

  /// Directive 6.3 K/O/P: recipient display + per-case HR-entered recipient
  /// (encrypted + masked exactly like the directory; never logged raw).
  recipientName           String?
  recipientOrg            String?
  recipientKind           String?
  recipientConfigId       String?  @db.Uuid
  caseRecipientCiphertext String?
  caseRecipientMask       String?

  /// Directive 6.3 T/U: acknowledgement / completion evidence (token or
  /// HR-recorded). Delivery alone is never completion.
  acknowledgedAt          DateTime?
  acknowledgedVia         String?
  completionConfirmedAt   DateTime?
  completionEvidenceNote  String?
  completionRecordedById  String?  @db.Uuid

  createdById String   @db.Uuid
  rowVersion  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  captures NotificationCapture[]
  outbox   NotificationOutbox[]
  tokens   ActionToken[]

  @@index([caseId])
  @@index([status])
  @@index([origin, scheduledSendAt])
  @@map("notification_record")
}

/// Directive 6.3 B/C: the per-case ledger of derived required actions with
/// full rule provenance. Live status is computed at read time from the linked
/// record - never stored (OVERDUE-is-never-stored principle).
model CaseRequiredAction {
  id            String              @id @default(uuid()) @db.Uuid
  caseId        String              @db.Uuid
  case          OffboardingCase     @relation(fields: [caseId], references: [id])
  workflowInstanceId String?        @db.Uuid
  /// Stable idempotency key within the case, e.g. 'EMAIL:IT_ACCESS_REMOVAL'.
  actionKey     String
  actionGroup   RequiredActionGroup
  kind          RequiredActionKind
  title         String
  applicable    Boolean
  determination DerivationResult
  ruleKey       String
  rulesVersion  String
  /// The exact inputs the rule consumed (audit provenance - Directive C).
  sourceFields  Json
  /// The rule output snapshot.
  result        Json
  derivedAt     DateTime
  overridden    Boolean             @default(false)
  overrideReason String?
  overriddenById String?            @db.Uuid
  overriddenAt  DateTime?
  /// Link to what the action produced (NotificationRecord / AssetRecoveryItem
  /// / SurveyInvitation id) - evidence, not duplication.
  refType       String?
  refId         String?             @db.Uuid
  supersededAt  DateTime?
  supersededReason String?
  rowVersion    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  notifications NotificationRecord[]

  @@unique([caseId, actionKey])
  @@index([caseId, actionGroup])
  @@map("case_required_action")
}

/// Directive 6.3 T: single-purpose no-login acknowledgement tokens. Hash-only
/// storage (survey-token discipline); the raw value exists only inside the
/// captured email body. Never exposes the case.
model ActionToken {
  id                   String             @id @default(uuid()) @db.Uuid
  notificationRecordId String             @db.Uuid
  notificationRecord   NotificationRecord @relation(fields: [notificationRecordId], references: [id])
  purpose              TokenPurpose
  /// sha256 hex; nulled on use/expiry/revocation so links die immediately.
  tokenHash            String?            @unique
  issuedAt             DateTime           @default(now())
  expiresAt            DateTime
  usedAt               DateTime?
  /// Optional short note from the confirmer (validated, length-capped).
  usedNote             String?
  revokedAt            DateTime?
  revokedReason        String?
  rowVersion           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([notificationRecordId])
  @@map("action_token")
}

enum NotificationOrigin {
  MANUAL
  DERIVED
}

enum BenefitsApplicability {
  YES
  NO
  UNKNOWN
}

enum RequiredActionGroup {
  HR
  DOCUMENTS
  MANAGER_HANDOVER
  IT
  FINANCE
  BENEFITS
  ASSETS
  SURVEY
  CLEARANCE
}

enum RequiredActionKind {
  EMAIL_ACTION
  ASSET_RECOVERY
  SURVEY_INVITATION
  BENEFITS_CONFIRMATION
}

enum DerivationResult {
  DERIVED
  DEFAULTED
  REQUIRES_REVIEW
  EXCEPTION
  NOT_APPLICABLE
}

enum TokenPurpose {
  ACKNOWLEDGE_RECEIPT
  CONFIRM_COMPLETION
}

/// Development capture adapter output (K.12-K.14): records what WOULD be
/// delivered; never represents an external delivery.
model NotificationCapture {
  id         String             @id @default(uuid()) @db.Uuid
  recordId   String             @db.Uuid
  record     NotificationRecord @relation(fields: [recordId], references: [id])
  capturedAt DateTime           @default(now())
  note       String
  subject    String
  body       String

  @@index([recordId])
  @@map("notification_capture")
}

/// Approved asset catalogue (section L).
model AssetCatalogueItem {
  id                String    @id @default(uuid()) @db.Uuid
  assetType         AssetType
  label             String    @unique
  trackIdentifier   Boolean   @default(false)
  issuingDepartment String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@map("asset_catalogue_item")
}

/// Employee-issued asset records (synthetic in development).
model IssuedAsset {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeSourceSystem String
  employeeSourceId     String
  assetType            AssetType
  catalogueLabel       String
  identifier           String?
  serialNumber         String?
  issuingDepartment    String
  issuedAt             DateTime?
  currentHolderNote    String?
  restricted           Boolean   @default(false)
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())

  recoveryItems AssetRecoveryItem[]

  @@index([employeeSourceId])
  @@map("issued_asset")
}

/// Case asset-recovery items (section L) - every required item needs a final
/// documented disposition before ordinary clearance.
model AssetRecoveryItem {
  id                    String              @id @default(uuid()) @db.Uuid
  caseId                String              @db.Uuid
  case                  OffboardingCase     @relation(fields: [caseId], references: [id])
  issuedAssetId         String?             @db.Uuid
  issuedAsset           IssuedAsset?        @relation(fields: [issuedAssetId], references: [id])
  manuallyAdded         Boolean             @default(false)
  assetType             AssetType
  label                 String
  identifier            String?
  serialNumber          String?
  responsibleDepartment TaskDepartment      @default(HR)
  expectedReturnAt      DateTime?
  requiredForClearance  Boolean             @default(true)
  status                AssetRecoveryStatus @default(EXPECTED)
  receivedById          String?             @db.Uuid
  receivedAt            DateTime?
  condition             String?
  remarks               String?
  evidenceAttachmentId  String?             @db.Uuid
  exceptionOwnerId      String?             @db.Uuid
  dispositionReason     String?
  dispositionById       String?             @db.Uuid
  dispositionAt         DateTime?
  rowVersion            Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([caseId])
  @@index([status])
  @@map("asset_recovery_item")
}

/// Knowledge-transfer and handover record (section M) - one per case.
/// Credential storage is rejected by validation; content is manager-owned.
model HandoverRecord {
  id                   String          @id @default(uuid()) @db.Uuid
  caseId               String          @unique @db.Uuid
  case                 OffboardingCase @relation(fields: [caseId], references: [id])
  status               HandoverStatus  @default(NOT_STARTED)
  requiredForClearance Boolean         @default(true)
  managerId            String?         @db.Uuid

  dutiesToReassign      String?
  openWorkDeadlines     String?
  customerVendorMatters String?
  keyDocumentLocations  String?
  physicalFileLocations String?
  replacementOwner      String?
  handoverSessions      String?
  trainingCompleted     String?
  unresolvedRisks       String?
  managerNotes          String?

  managerAttestedById String?   @db.Uuid
  managerAttestedAt   DateTime?
  hrReviewedById      String?   @db.Uuid
  hrReviewedAt        DateTime?
  hrReviewNote        String?
  notApplicableReason String?
  waiverReason        String?
  waivedById          String?   @db.Uuid
  waivedAt            DateTime?
  completedAt         DateTime?

  rowVersion Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("handover_record")
}

/// Exception and escalation records (section N). Open exceptions are
/// deduplicated per (case, type, reference) by a partial unique index.
model CaseException {
  id             String            @id @default(uuid()) @db.Uuid
  caseId         String            @db.Uuid
  case           OffboardingCase   @relation(fields: [caseId], references: [id])
  exceptionType  ExceptionType
  severity       ExceptionSeverity
  status         ExceptionStatus   @default(OPEN)
  refType        String?
  refId          String?
  title          String
  detail         String?
  ownerDepartment TaskDepartment?
  ownerId        String?           @db.Uuid
  dueAt          DateTime?
  /// I.10: HR_MANAGER-approved security exception for unresolved access.
  securityExceptionApproved Boolean @default(false)
  resolution     String?
  resolvedById   String?           @db.Uuid
  resolvedAt     DateTime?
  correlationId  String
  rowVersion     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([caseId, status])
  @@index([exceptionType, status])
  @@index([status, severity])
  @@map("case_exception")
}

// --- Stage 4: outbox, providers, pilot, privacy, operations ------------------

enum ProvisioningStatus {
  ACTIVE
  PENDING
  DEACTIVATED
}

enum OutboxStatus {
  PENDING
  CLAIMED
  SUBMITTED
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
  DEAD_LETTER
}

enum RecipientClassDir {
  IT_OFFBOARDING
  FINANCE_OFFBOARDING
  HR_OFFBOARDING
  LINE_MANAGER
  SAGICOR_GROUP_HEALTH
  NCB_GROUP_LIFE
  EMPLOYEE_PERSONAL
  OTHER_APPROVED_EXTERNAL
  /// Directive 6.3 N: independently configurable provider purposes.
  PAYROLL_BANK
  PENSION_PROVIDER
}

enum RecipientApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  RETIRED
}

enum ActivationState {
  DISABLED
  TEST_ONLY
  TRAINING_ENABLED
  PILOT_READY
  PILOT_ACTIVE
  POST_ROLLOUT_READY
  POST_ROLLOUT_ACTIVE
  SUSPENDED
}

enum SupportCategory {
  INCIDENT
  SERVICE_REQUEST
  INTEGRATION_FAILURE
  SECURITY_PRIVACY_INCIDENT
  DATA_CORRECTION
  ACCESS_REQUEST
  CONFIGURATION_ISSUE
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OutageStatus {
  DECLARED
  RESTORED
  CLOSED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RetentionRunMode {
  DRY_RUN
  EXECUTE
}

enum DsrType {
  ACCESS
  CORRECTION
  EXPORT
}

/// Durable transactional outbox (Directive 4 section B). Created in the SAME
/// transaction as the notification approval so nothing is lost on crash.
model NotificationOutbox {
  id                   String             @id @default(uuid()) @db.Uuid
  notificationRecordId String             @db.Uuid
  notificationRecord   NotificationRecord @relation(fields: [notificationRecordId], references: [id])
  provider             String
  recipientClass       RecipientClassDir
  recipientConfigId    String?            @db.Uuid
  /// Masked display only; the real destination stays encrypted on the config.
  destinationMask      String
  subjectSnapshot      String
  contentChecksum      String
  templateVersion      Int
  workflowVersion      Int
  idempotencyKey       String             @unique
  status               OutboxStatus       @default(PENDING)
  scheduledAt          DateTime           @default(now())
  claimedAt            DateTime?
  attempts             Int                @default(0)
  nextAttemptAt        DateTime           @default(now())
  submittedAt          DateTime?
  providerMessageRef   String?
  /// SUBMITTED vs provider-evidenced DELIVERED vs BOUNCED/REJECTED/CAPTURED.
  deliveryStatus       String?
  lastErrorCode        String?
  cancelReason         String?
  resolvedById         String?            @db.Uuid
  resolvedAt           DateTime?
  resolutionNote       String?
  correlationId        String
  rowVersion           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([notificationRecordId])
  @@map("notification_outbox")
}

/// Controlled recipient directory (section D). Destinations are encrypted at
/// rest through the application boundary; no real address is ever seeded.
model RecipientConfig {
  id                    String                  @id @default(uuid()) @db.Uuid
  recipientClass        RecipientClassDir
  displayName           String
  destinationCiphertext String
  destinationMask       String
  active                Boolean                 @default(true)
  environment           String                  @default("development")
  allowedTypes          NotificationType[]
  isExternal            Boolean                 @default(false)
  /// Directive 6.3 N/P: purpose + human identity for the provider directory.
  /// Purposes: GROUP_HEALTH_REMOVAL, GROUP_LIFE_REMOVAL,
  /// PAYROLL_OR_BANK_NOTIFICATION, PENSION_NOTIFICATION, OTHER_APPROVED_PROVIDER.
  purpose               String?
  organizationName      String?
  contactName           String?
  ownerId               String?                 @db.Uuid
  approvalStatus        RecipientApprovalStatus @default(DRAFT)
  approvedById          String?                 @db.Uuid
  approvedAt            DateTime?
  effectiveFrom         DateTime?
  verifiedAt            DateTime?
  changeReason          String?
  createdById           String                  @db.Uuid
  rowVersion            Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([recipientClass, environment])
  @@map("recipient_config")
}

/// Technical configuration (secret REFERENCES only - never raw secrets).
model SystemConfig {
  key         String   @id
  value       Json
  secretRef   String?
  reason      String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

/// Periodic user-access review snapshots (E.10) - append-only evidence.
model AccessReview {
  id            String   @id @default(uuid()) @db.Uuid
  generatedById String   @db.Uuid
  generatedAt   DateTime @default(now())
  payload       Json
  note          String?
  correlationId String

  @@map("access_review")
}

/// Employee-source synchronization runs (section F) - append-only evidence.
model EmployeeSyncRun {
  id            String    @id @default(uuid()) @db.Uuid
  source        String
  mode          String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdCount  Int       @default(0)
  updatedCount  Int       @default(0)
  mismatches    Json?
  startedById   String?   @db.Uuid
  correlationId String

  @@map("employee_sync_run")
}

/// Pilot/environment activation evidence (section L). Core fields freeze once
/// recorded; only approvals and lifecycle fields may change (trigger).
model PilotActivation {
  id                       String          @id @default(uuid()) @db.Uuid
  state                    ActivationState
  environment              String
  cohort                   String
  scope                    Json
  startDate                DateTime?
  enabledIntegrations      Json
  approvedWorkflowVersions Json
  approvedTemplateVersions Json
  approvedCalendarVersion  Int?
  conditions               String?
  rollbackPlan             String
  checksum                 String
  hrApprovedById           String?         @db.Uuid
  hrApprovedAt             DateTime?
  adminApprovedById        String?         @db.Uuid
  adminApprovedAt          DateTime?
  privacyApprovedById      String?         @db.Uuid
  privacyApprovedAt        DateTime?
  activatedAt              DateTime?
  suspendedAt              DateTime?
  suspendReason            String?
  supersededAt             DateTime?
  createdById              String          @db.Uuid
  correlationId            String
  rowVersion               Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([state])
  @@map("pilot_activation")
}

/// Scheduled report definitions (section O).
model ScheduledReport {
  id             String            @id @default(uuid()) @db.Uuid
  reportKey      String
  name           String
  frequency      ReportFrequency
  recipientClass RecipientClassDir
  format         String            @default("CSV")
  filters        Json
  active         Boolean           @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  lastStatus     String?
  lastError      String?
  createdById    String            @db.Uuid
  rowVersion     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  runs ReportRun[]

  @@map("scheduled_report")
}

/// Scheduled report runs - append-only evidence.
model ReportRun {
  id                String          @id @default(uuid()) @db.Uuid
  scheduledReportId String          @db.Uuid
  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id])
  ranAt             DateTime        @default(now())
  status            String
  rowCount          Int             @default(0)
  objectKey         String?
  error             String?
  correlationId     String

  @@index([scheduledReportId])
  @@map("report_run")
}

/// Versioned retention policies (section P) - synthetic in development.
model RetentionPolicy {
  id           String    @id @default(uuid()) @db.Uuid
  recordType   String
  retainYears  Int
  basis        String
  version      Int
  active       Boolean   @default(false)
  approvedById String?   @db.Uuid
  approvedAt   DateTime?
  createdById  String    @db.Uuid
  reason       String?
  createdAt    DateTime  @default(now())

  @@unique([recordType, version])
  @@map("retention_policy")
}

/// Legal/administrative holds suspend all retention action (P.3/P.4).
model RetentionHold {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @db.Uuid
  case         OffboardingCase @relation(fields: [caseId], references: [id])
  reason       String
  placedById   String    @db.Uuid
  placedAt     DateTime  @default(now())
  releasedById String?   @db.Uuid
  releasedAt   DateTime?
  releaseNote  String?

  @@index([caseId])
  @@map("retention_hold")
}

/// Retention dry-run/execution evidence - append-only.
model RetentionRun {
  id            String           @id @default(uuid()) @db.Uuid
  mode          RetentionRunMode
  policyVersion Int
  startedById   String           @db.Uuid
  startedAt     DateTime         @default(now())
  findings      Json
  executedCount Int              @default(0)
  correlationId String

  @@map("retention_run")
}

/// Disclosure log (P.9) - append-only evidence.
model DisclosureLog {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String?  @db.Uuid
  subjectRef   String
  disclosedTo  String
  description  String
  lawfulBasis  String
  disclosedById String  @db.Uuid
  disclosedAt  DateTime @default(now())
  correlationId String

  @@map("disclosure_log")
}

/// Data-subject requests (P.6-P.8).
model DataSubjectRequest {
  id               String   @id @default(uuid()) @db.Uuid
  type             DsrType
  subjectRef       String
  status           String   @default("OPEN")
  note             String?
  packageObjectKey String?
  requestedAt      DateTime @default(now())
  handledById      String?  @db.Uuid
  completedAt      DateTime?
  correlationId    String
  rowVersion       Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("data_subject_request")
}

/// Backup evidence (section Q) - core fields immutable via trigger.
model BackupRecord {
  id               String    @id @default(uuid()) @db.Uuid
  kind             String    @default("DATABASE")
  objectPath       String
  sizeBytes        BigInt
  checksum         String
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  verifiedAt       DateTime?
  verificationNote String?
  correlationId    String

  @@map("backup_record")
}

/// Declared outages for manual fallback (section R).
model Outage {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  status       OutageStatus @default(DECLARED)
  declaredById String       @db.Uuid
  declaredAt   DateTime     @default(now())
  restoredAt   DateTime?
  closedById   String?      @db.Uuid
  closedAt     DateTime?
  note         String?
  rowVersion   Int          @default(0)
  updatedAt    DateTime     @updatedAt

  entries FallbackEntry[]

  @@map("outage")
}

/// Manual records captured during an outage; reconciled on restore (R.3-R.5).
model FallbackEntry {
  id             String    @id @default(uuid()) @db.Uuid
  outageId       String    @db.Uuid
  outage         Outage    @relation(fields: [outageId], references: [id])
  refNumber      String    @unique
  kind           String
  summary        String
  recordedById   String    @db.Uuid
  recordedAt     DateTime  @default(now())
  reconciledCaseId String? @db.Uuid
  reconciledById String?   @db.Uuid
  reconciledAt   DateTime?
  reconcileNote  String?
  rowVersion     Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@index([outageId])
  @@map("fallback_entry")
}

/// Support and incident records (section T). Linked case only where
/// authorized; descriptions are safe operational text.
model SupportTicket {
  id                String          @id @default(uuid()) @db.Uuid
  category          SupportCategory
  severity          ExceptionSeverity
  environment       String          @default("development")
  title             String
  description       String
  affectedComponent String?
  reporterId        String          @db.Uuid
  ownerId           String?         @db.Uuid
  status            SupportStatus   @default(OPEN)
  resolution        String?
  linkedExceptionId String?         @db.Uuid
  linkedCaseId      String?         @db.Uuid
  correlationId     String
  rowVersion        Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resolvedAt        DateTime?

  @@index([status, severity])
  @@map("support_ticket")
}

/// Role-scoped training completion (section S) - not formal certification.
model TrainingCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  role        Role
  module      String
  completedAt DateTime @default(now())

  @@unique([userId, module])
  @@map("training_completion")
}

/// Immutable final-clearance approval evidence (section O).
model ClearanceRecord {
  id                 String          @id @default(uuid()) @db.Uuid
  caseId             String          @db.Uuid
  case               OffboardingCase @relation(fields: [caseId], references: [id])
  workflowInstanceId String          @db.Uuid
  workflowVersion    Int
  decision           String          @default("APPROVED")
  actorId            String          @db.Uuid
  actorDisplayName   String
  actorRole          String
  meaning            String
  snapshot           Json
  unresolvedApprovedExceptions Json
  checksum           String
  correlationId      String
  createdAt          DateTime        @default(now())

  @@index([caseId])
  @@map("clearance_record")
}
